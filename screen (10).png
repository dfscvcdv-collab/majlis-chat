<!DOCTYPE html>

<html class="dark" dir="rtl" lang="ar"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>AL-QALLABI | Sketch &amp; Guess</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&amp;family=Manrope:wght@300;400;500;600;700&amp;family=Tajawal:wght@400;500;700;900&amp;family=Cairo:wght@400;600;700;900&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            "colors": {
                    "surface-tint": "#8eff71",
                    "inverse-surface": "#f9f9f9",
                    "outline-variant": "#484848",
                    "error-container": "#b92902",
                    "inverse-on-surface": "#555555",
                    "outline": "#757575",
                    "secondary": "#ff7441",
                    "primary-container": "#2ff801",
                    "on-primary-fixed": "#064200",
                    "on-background": "#ffffff",
                    "on-primary-container": "#0b5800",
                    "secondary-container": "#ab3600",
                    "surface-dim": "#0e0e0e",
                    "on-error-container": "#ffd2c8",
                    "surface-variant": "#262626",
                    "on-error": "#450900",
                    "tertiary": "#81ecff",
                    "tertiary-fixed": "#00e3fd",
                    "on-secondary-fixed": "#631b00",
                    "on-primary-fixed-variant": "#0d6200",
                    "surface-container-high": "#1f1f1f",
                    "tertiary-fixed-dim": "#00d4ec",
                    "on-surface": "#ffffff",
                    "primary-fixed": "#2ff801",
                    "error-dim": "#d53d18",
                    "surface-bright": "#2c2c2c",
                    "on-primary": "#0d6100",
                    "on-secondary-container": "#fff6f3",
                    "inverse-primary": "#106f00",
                    "tertiary-container": "#00e3fd",
                    "error": "#ff7351",
                    "secondary-fixed-dim": "#ffb197",
                    "background": "#0e0e0e",
                    "on-secondary-fixed-variant": "#932d00",
                    "surface-container-lowest": "#000000",
                    "on-surface-variant": "#ababab",
                    "surface": "#0e0e0e",
                    "on-tertiary-container": "#004d57",
                    "surface-container": "#191919",
                    "secondary-fixed": "#ffc4b1",
                    "primary": "#8eff71",
                    "secondary-dim": "#ff7441",
                    "on-tertiary-fixed-variant": "#005762",
                    "on-secondary": "#410f00",
                    "tertiary-dim": "#00d4ec",
                    "primary-fixed-dim": "#2be800",
                    "primary-dim": "#2be800",
                    "surface-container-low": "#131313",
                    "on-tertiary-fixed": "#003840",
                    "on-tertiary": "#005762",
                    "surface-container-highest": "#262626"
            },
            "borderRadius": {
                    "DEFAULT": "0.125rem",
                    "lg": "0.25rem",
                    "xl": "0.5rem",
                    "full": "0.75rem"
            },
            "fontFamily": {
                    "headline": ["Space Grotesk", "Tajawal"],
                    "body": ["Manrope", "Cairo"],
                    "label": ["Space Grotesk", "Tajawal"]
            }
          },
        },
      }
    </script>
<style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
            display: inline-block;
            line-height: 1;
            text-transform: none;
            letter-spacing: normal;
            word-wrap: normal;
            white-space: nowrap;
            direction: ltr;
        }
        .kinetic-bg {
            background-image: radial-gradient(circle at 50% 50%, #1a3a10 0%, #0e0e0e 100%);
        }
        .neon-glow {
            box-shadow: 0 0 15px rgba(57, 255, 20, 0.4);
        }
        .glass-panel {
            background: rgba(31, 31, 31, 0.6);
            backdrop-filter: blur(20px);
        }
    </style>
</head>
<body class="bg-background text-on-background font-body min-h-screen overflow-hidden">
<!-- Top Navigation (Shell) -->
<header class="flex justify-between items-center w-full px-6 py-4 fixed top-0 z-50 bg-[#0e0e0e]">
<div class="flex items-center gap-6">
<h1 class="text-2xl font-black italic text-[#39FF14] drop-shadow-[0_0_8px_rgba(57,255,20,0.6)] font-headline tracking-tighter uppercase">AL-QALLABI</h1>
<div class="hidden md:flex gap-4">
<a class="text-[#39FF14] border-b-2 border-[#39FF14] font-headline tracking-tighter uppercase hover:text-[#39FF14] hover:drop-shadow-[0_0_5px_#39FF14] transition-all" href="#">Home</a>
<a class="text-gray-500 font-headline tracking-tighter uppercase hover:text-[#39FF14] hover:drop-shadow-[0_0_5px_#39FF14] transition-all" href="#">Lobbies</a>
</div>
</div>
<div class="flex items-center gap-4">
<span class="material-symbols-outlined text-[#39FF14]">settings</span>
<span class="material-symbols-outlined text-[#39FF14]">account_circle</span>
</div>
<div class="bg-gradient-to-r from-transparent via-[#39FF14]/20 to-transparent h-[1px] w-full absolute bottom-0"></div>
</header>
<!-- Side Navigation (Shell) -->
<aside class="fixed left-0 top-0 h-full pt-20 pb-6 flex flex-col z-40 bg-[#131313]/90 backdrop-blur-xl w-64 shadow-[10px_0_30px_rgba(0,0,0,0.5)] border-r border-[#39FF14]/10 hidden lg:flex">
<div class="px-6 mb-8">
<div class="text-[#39FF14] font-black font-headline">OPERATOR</div>
<div class="text-[#39FF14] text-xs opacity-60">ONLINE</div>
</div>
<nav class="flex-grow">
<div class="text-[#39FF14] bg-[#39FF14]/5 border-r-4 border-[#39FF14] pl-4 py-3 flex items-center gap-3 font-headline text-sm font-bold cursor-pointer transition-colors translate-x-1 duration-200">
<span class="material-symbols-outlined">grid_view</span>
<span>Home</span>
</div>
<div class="text-gray-400 hover:text-gray-200 pl-4 py-3 flex items-center gap-3 font-headline text-sm font-bold cursor-pointer hover:bg-[#1f1f1f] transition-colors">
<span class="material-symbols-outlined">swords</span>
<span>Lobbies</span>
</div>
<div class="text-gray-400 hover:text-gray-200 pl-4 py-3 flex items-center gap-3 font-headline text-sm font-bold cursor-pointer hover:bg-[#1f1f1f] transition-colors">
<span class="material-symbols-outlined">trophy</span>
<span>Leaderboard</span>
</div>
<div class="text-gray-400 hover:text-gray-200 pl-4 py-3 flex items-center gap-3 font-headline text-sm font-bold cursor-pointer hover:bg-[#1f1f1f] transition-colors">
<span class="material-symbols-outlined">person</span>
<span>Profile</span>
</div>
</nav>
<div class="mt-auto px-4">
<button class="w-full bg-[#39FF14] text-on-primary font-bold py-3 rounded-md neon-glow hover:brightness-110 transition-all uppercase tracking-widest text-sm mb-6">
                CREATE ROOM
            </button>
<div class="space-y-2">
<div class="text-gray-400 hover:text-gray-200 pl-2 py-2 flex items-center gap-3 font-headline text-xs cursor-pointer">
<span class="material-symbols-outlined text-sm">help</span>
<span>Support</span>
</div>
<div class="text-gray-400 hover:text-gray-200 pl-2 py-2 flex items-center gap-3 font-headline text-xs cursor-pointer">
<span class="material-symbols-outlined text-sm">logout</span>
<span>Logout</span>
</div>
</div>
</div>
</aside>
<!-- Main Content Area -->
<main class="lg:mr-64 lg:ml-0 pt-24 px-6 h-screen flex flex-col gap-6 kinetic-bg">
<!-- Header Info Bar -->
<div class="flex justify-between items-center bg-surface-container-high rounded-lg p-4 border-b-2 border-primary/20">
<div class="flex items-center gap-4">
<div class="bg-secondary px-4 py-2 rounded-md font-black text-on-secondary flex items-center gap-2">
<span class="material-symbols-outlined">timer</span>
<span class="text-xl font-headline">00:42</span>
</div>
<div class="hidden md:block">
<h2 class="text-on-surface-variant text-sm font-bold uppercase tracking-widest">الجولة</h2>
<p class="text-primary font-black">3 من 5</p>
</div>
</div>
<div class="flex flex-col items-center">
<div class="flex gap-2">
<div class="w-8 h-1 bg-primary rounded-full"></div>
<div class="w-8 h-1 bg-primary rounded-full"></div>
<div class="w-8 h-1 bg-primary rounded-full"></div>
<div class="w-8 h-1 bg-surface-container-highest rounded-full"></div>
<div class="w-8 h-1 bg-surface-container-highest rounded-full"></div>
</div>
<div class="mt-2 flex gap-4 text-2xl font-black tracking-[0.5em] text-on-surface">
<span>_</span> <span>_</span> <span>_</span> <span>_</span> <span>_</span>
</div>
</div>
<div class="text-left">
<div class="text-on-surface-variant text-sm font-bold uppercase tracking-widest">الغرفة</div>
<div class="text-tertiary font-black font-headline tracking-tighter">#OMEGA_99</div>
</div>
</div>
<div class="flex-grow grid grid-cols-12 gap-6 overflow-hidden pb-6">
<!-- Left Side: Chat (Using asymm flow) -->
<div class="col-span-12 lg:col-span-3 flex flex-col gap-4 overflow-hidden">
<div class="glass-panel rounded-xl flex-grow flex flex-col overflow-hidden border border-outline-variant/30">
<div class="p-4 border-b border-outline-variant/30 flex justify-between items-center">
<span class="font-bold text-primary tracking-widest uppercase text-xs">Live Chat</span>
<span class="material-symbols-outlined text-on-surface-variant">forum</span>
</div>
<div class="flex-grow overflow-y-auto p-4 space-y-4">
<!-- Chat Message -->
<div class="flex flex-col gap-1">
<span class="text-xs font-bold text-secondary">عمر_99</span>
<div class="bg-surface-container rounded-lg p-3 text-sm">هل هي سيارة؟</div>
</div>
<div class="flex flex-col gap-1">
<span class="text-xs font-bold text-tertiary">خالد_الرسام</span>
<div class="bg-surface-container-high rounded-lg p-3 text-sm italic text-on-surface-variant">يتم الآن الرسم...</div>
</div>
<!-- Successful Guess -->
<div class="bg-primary/10 border border-primary/20 rounded-lg p-3 flex items-center gap-3">
<span class="material-symbols-outlined text-primary text-sm">check_circle</span>
<p class="text-xs font-bold text-primary">أحمد خمن الكلمة بنجاح!</p>
</div>
<div class="flex flex-col gap-1">
<span class="text-xs font-bold text-on-surface-variant">سارة_88</span>
<div class="bg-surface-container rounded-lg p-3 text-sm">بيت؟</div>
</div>
</div>
</div>
</div>
<!-- Center: Drawing Canvas -->
<div class="col-span-12 lg:col-span-6 flex flex-col gap-4 relative">
<div class="flex-grow bg-white rounded-xl shadow-[0_0_50px_rgba(255,255,255,0.05)] relative overflow-hidden group">
<!-- The Canvas Simulation -->
<div class="absolute inset-0 flex items-center justify-center pointer-events-none">
<img class="w-full h-full object-cover opacity-20 grayscale" data-alt="abstract artistic sketch strokes on white background with charcoal texture and expressive lines" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCBlimuWFerVt6o5WMdSlmZ22cysE2Gp8zol2fqMNm1LJgxLVX0wANXoYDbDgpjM_9XNke4Hbvd4JHl4wjCAF1VokPwfg-tE46PlIf1cHC4UDTPWlHk76M6vp_ck2fp9xNP1UvaeHrYIFtGalj6kJI7lHUCVSyFk5LIFaKxafYpDNBldumlmMdbM8ansABVxvUiGGa02jvRFP9UzJUVaCH48blluCzuRDWeiS-KzavDvF1unKAKC4MzCLp00r1MmWoO2C_lFUCzXJA"/>
</div>
<canvas class="absolute inset-0 w-full h-full cursor-crosshair z-10"></canvas>
<!-- Guessing UI Overlay -->
<div class="absolute bottom-6 left-6 right-6 z-20">
<div class="bg-surface-container-lowest/80 backdrop-blur-md rounded-xl p-2 flex gap-2 border border-primary/30 shadow-2xl">
<input class="flex-grow bg-transparent border-none focus:ring-0 text-on-surface font-bold px-4 py-3 placeholder:text-on-surface-variant/50 text-right" dir="rtl" placeholder="اكتب تخمينك هنا..." type="text"/>
<button class="bg-primary text-on-primary font-black px-8 py-3 rounded-lg hover:bg-primary-container transition-all flex items-center gap-2 group">
<span>تخمين</span>
<span class="material-symbols-outlined group-hover:translate-x-[-4px] transition-transform">send</span>
</button>
</div>
</div>
</div>
</div>
<!-- Right Side: Players List -->
<div class="col-span-12 lg:col-span-3 flex flex-col gap-4 overflow-hidden">
<div class="glass-panel rounded-xl flex-grow flex flex-col border border-outline-variant/30">
<div class="p-4 border-b border-outline-variant/30 flex justify-between items-center">
<span class="font-bold text-primary tracking-widest uppercase text-xs">Players</span>
<span class="text-xs text-on-surface-variant">8/10</span>
</div>
<div class="p-2 space-y-1">
<!-- Player Card: Drawing -->
<div class="flex items-center justify-between p-3 bg-primary/5 border border-primary/20 rounded-lg">
<div class="flex items-center gap-3">
<div class="relative">
<img class="w-10 h-10 rounded-full border-2 border-primary" data-alt="close up profile of a young man with neon lighting on his face gaming headphones" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAXNbvQX8Jw9_-uqUQlGgAH5FGUtVMeGqSzI9wH6pMEhcbxsIQF2gCJdExtDQyxlGqOVYh_rGlaog3ebDIHd_wUZbuPx7H5LsmNPLYU49SpouLPJLeqCpqQGu6nveotq5FCIzFpa-FoqHsj283npVtmq3kMsyIGx5bacL9GEk2lgCnp_iNxxSolGZ_7GkZs4cxGKWTSBmh9g9yzAs0helXrYmWStlsho8c29bDe0-wbYpjcZ4a6bt6myE_DC7A7yN_7PrXS_KgKT5c"/>
<div class="absolute -bottom-1 -right-1 bg-primary text-on-primary rounded-full p-0.5">
<span class="material-symbols-outlined text-[10px]" style="font-variation-settings: 'FILL' 1;">edit</span>
</div>
</div>
<div>
<div class="text-sm font-bold text-on-surface">خالد_الرسام</div>
<div class="text-[10px] text-primary-container uppercase font-black">Drawing</div>
</div>
</div>
<div class="text-primary font-headline font-black">1,240</div>
</div>
<!-- Player Card: Guessed -->
<div class="flex items-center justify-between p-3 hover:bg-surface-container transition-colors rounded-lg group">
<div class="flex items-center gap-3">
<div class="relative">
<img class="w-10 h-10 rounded-full grayscale group-hover:grayscale-0 transition-all" data-alt="portrait of a man in dark lighting with blue rim light" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBXth-Ue-USVTakdHG5VPqZ1Q31LFKA1IX9lj5ws4iSXbb6cL_iKp2mKRCd4v0k3imeI1HJsaVfM2qjEEzjf4bDc1slS51oxpPcf0N4BAeNyyWObxW-ZuRNvT5mZ1C2_GXNJ1ZZvXxT50QllNmbMEgtZWQrcolL7A5xaySh6V4YxxlyLxCp_pkgkNFTGGzSyrOzYXScgp23Y3Wky-2QzqbiRBqgDD7qB5kRE3mZrltkcDhKO3jrlc2U9MmpToKuMBYCnhHpM7F7DcA"/>
<div class="absolute -bottom-1 -right-1 bg-[#39FF14] text-on-primary rounded-full p-0.5">
<span class="material-symbols-outlined text-[10px]" style="font-variation-settings: 'FILL' 1;">check</span>
</div>
</div>
<div>
<div class="text-sm font-bold text-on-surface">أحمد</div>
<div class="text-[10px] text-primary uppercase font-black">Correct!</div>
</div>
</div>
<div class="text-on-surface-variant font-headline font-black">980</div>
</div>
<!-- Player Card: Waiting -->
<div class="flex items-center justify-between p-3 hover:bg-surface-container transition-colors rounded-lg">
<div class="flex items-center gap-3">
<img class="w-10 h-10 rounded-full grayscale" data-alt="vibrant portrait of a woman with neon green background lighting" src="https://lh3.googleusercontent.com/aida-public/AB6AXuB97gLZfCK0m3qaEThIu21p2wzLTeTEbYAIDMEOfs7xdrwhEk_79SJEcGSnfxGU4m7bdyoKAcQaAw6Bohc5uxP8CqZM1QtmGH5mxnE8YK1UXluVK-p2KJarBWRWhpQJXmLwk7VbmnOkCfUPFS_-ZRJ-NdATAwPXptjl_5Z6zT33HwZCBtv3Nmj24NpIESxzY-5Wzh-V3ei85qbeVG9S67X2a-vuu7xSRaBtFkFRUTZYIsXErr22k2vUnI8CKc-j5elRRnxniWFpIOk"/>
<div>
<div class="text-sm font-bold text-on-surface">سارة_88</div>
<div class="text-[10px] text-on-surface-variant uppercase">Guessing...</div>
</div>
</div>
<div class="text-on-surface-variant font-headline font-black">750</div>
</div>
<!-- More players... -->
<div class="flex items-center justify-between p-3 hover:bg-surface-container transition-colors rounded-lg opacity-60">
<div class="flex items-center gap-3">
<div class="w-10 h-10 rounded-full bg-surface-container-highest flex items-center justify-center">
<span class="material-symbols-outlined text-on-surface-variant">person</span>
</div>
<div>
<div class="text-sm font-bold text-on-surface">عمر_99</div>
<div class="text-[10px] text-on-surface-variant uppercase">Guessing...</div>
</div>
</div>
<div class="text-on-surface-variant font-headline font-black">420</div>
</div>
</div>
<div class="mt-auto p-4 bg-surface-container-lowest/40 flex items-center justify-between border-t border-outline-variant/20">
<div class="flex items-center gap-2">
<span class="flex h-2 w-2 rounded-full bg-primary animate-pulse"></span>
<span class="text-xs text-primary font-bold uppercase">Game Live</span>
</div>
<div class="flex gap-2">
<button class="p-2 hover:bg-surface-container-high rounded-full transition-colors">
<span class="material-symbols-outlined text-sm text-on-surface-variant">volume_up</span>
</button>
<button class="p-2 hover:bg-surface-container-high rounded-full transition-colors">
<span class="material-symbols-outlined text-sm text-on-surface-variant">share</span>
</button>
</div>
</div>
</div>
</div>
</div>
</main>
<!-- Background Elements for Atmosphere -->
<div class="fixed inset-0 pointer-events-none z-[-1] opacity-20">
<div class="absolute top-1/4 -right-20 w-96 h-96 bg-primary/20 blur-[120px] rounded-full"></div>
<div class="absolute bottom-1/4 -left-20 w-96 h-96 bg-secondary/10 blur-[120px] rounded-full"></div>
</div>
<!-- Mobile Bottom Nav (Shell) -->
<footer class="md:hidden fixed bottom-0 left-0 w-full bg-[#131313] px-6 py-3 flex justify-around items-center z-50 border-t border-outline-variant/20">
<div class="flex flex-col items-center text-primary">
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">grid_view</span>
<span class="text-[10px] uppercase font-bold mt-1">Home</span>
</div>
<div class="flex flex-col items-center text-gray-500">
<span class="material-symbols-outlined">swords</span>
<span class="text-[10px] uppercase font-bold mt-1">Lobbies</span>
</div>
<div class="flex flex-col items-center text-gray-500">
<span class="material-symbols-outlined">trophy</span>
<span class="text-[10px] uppercase font-bold mt-1">Ranks</span>
</div>
<div class="flex flex-col items-center text-gray-500">
<span class="material-symbols-outlined">person</span>
<span class="text-[10px] uppercase font-bold mt-1">Profile</span>
</div>
</footer>
</body></html>