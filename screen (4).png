<!DOCTYPE html>

<html class="dark" dir="rtl" lang="ar"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700;900&amp;family=Manrope:wght@200;400;600;800&amp;family=Cairo:wght@400;700;900&amp;family=Tajawal:wght@400;700;900&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            "colors": {
                    "surface-tint": "#8eff71",
                    "inverse-surface": "#f9f9f9",
                    "outline-variant": "#484848",
                    "error-container": "#b92902",
                    "inverse-on-surface": "#555555",
                    "outline": "#757575",
                    "secondary": "#ff7441",
                    "primary-container": "#2ff801",
                    "on-primary-fixed": "#064200",
                    "on-background": "#ffffff",
                    "on-primary-container": "#0b5800",
                    "secondary-container": "#ab3600",
                    "surface-dim": "#0e0e0e",
                    "on-error-container": "#ffd2c8",
                    "surface-variant": "#262626",
                    "on-error": "#450900",
                    "tertiary": "#81ecff",
                    "tertiary-fixed": "#00e3fd",
                    "on-secondary-fixed": "#631b00",
                    "on-primary-fixed-variant": "#0d6200",
                    "surface-container-high": "#1f1f1f",
                    "tertiary-fixed-dim": "#00d4ec",
                    "on-surface": "#ffffff",
                    "primary-fixed": "#2ff801",
                    "error-dim": "#d53d18",
                    "surface-bright": "#2c2c2c",
                    "on-primary": "#0d6100",
                    "on-secondary-container": "#fff6f3",
                    "inverse-primary": "#106f00",
                    "tertiary-container": "#00e3fd",
                    "error": "#ff7351",
                    "secondary-fixed-dim": "#ffb197",
                    "background": "#0e0e0e",
                    "on-secondary-fixed-variant": "#932d00",
                    "surface-container-lowest": "#000000",
                    "on-surface-variant": "#ababab",
                    "surface": "#0e0e0e",
                    "on-tertiary-container": "#004d57",
                    "surface-container": "#191919",
                    "secondary-fixed": "#ffc4b1",
                    "primary": "#8eff71",
                    "secondary-dim": "#ff7441",
                    "on-tertiary-fixed-variant": "#005762",
                    "on-secondary": "#410f00",
                    "tertiary-dim": "#00d4ec",
                    "primary-fixed-dim": "#2be800",
                    "primary-dim": "#2be800",
                    "surface-container-low": "#131313",
                    "on-tertiary-fixed": "#003840",
                    "on-tertiary": "#005762",
                    "surface-container-highest": "#262626"
            },
            "borderRadius": {
                    "DEFAULT": "0.125rem",
                    "lg": "0.25rem",
                    "xl": "0.5rem",
                    "full": "0.75rem"
            },
            "fontFamily": {
                    "headline": ["Space Grotesk", "Cairo"],
                    "body": ["Manrope", "Tajawal"],
                    "label": ["Space Grotesk", "Tajawal"]
            }
          },
        },
      }
    </script>
<style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .neon-glow-primary {
            box-shadow: 0 0 15px rgba(142, 255, 113, 0.3);
        }
        .neon-text-primary {
            text-shadow: 0 0 8px rgba(142, 255, 113, 0.6);
        }
        .kinetic-void-bg {
            background: radial-gradient(circle at 50% 50%, #1a1a1a 0%, #0e0e0e 100%);
        }
        body {
            font-family: 'Manrope', 'Tajawal', sans-serif;
        }
    </style>
</head>
<body class="bg-background text-on-background kinetic-void-bg min-h-screen overflow-hidden">
<!-- TopNavBar -->
<nav class="flex justify-between items-center w-full px-6 py-4 fixed top-0 z-50 bg-[#0e0e0e]">
<div class="flex items-center gap-4">
<span class="text-2xl font-black italic text-[#39FF14] drop-shadow-[0_0_8px_rgba(57,255,20,0.6)] font-space-grotesk tracking-tighter uppercase">AL-QALLABI</span>
</div>
<div class="hidden md:flex items-center gap-8 font-space-grotesk tracking-tighter uppercase">
<a class="text-[#39FF14] border-b-2 border-[#39FF14] hover:text-[#39FF14] hover:drop-shadow-[0_0_5px_#39FF14] transition-all scale-95 active:duration-75" href="#">Lobbies</a>
<a class="text-gray-500 hover:text-[#39FF14] hover:drop-shadow-[0_0_5px_#39FF14] transition-all scale-95 active:duration-75" href="#">Leaderboard</a>
<a class="text-gray-500 hover:text-[#39FF14] hover:drop-shadow-[0_0_5px_#39FF14] transition-all scale-95 active:duration-75" href="#">Store</a>
</div>
<div class="flex items-center gap-4 text-[#39FF14]">
<button class="material-symbols-outlined hover:drop-shadow-[0_0_5px_#39FF14] transition-all" data-icon="settings">settings</button>
<button class="material-symbols-outlined hover:drop-shadow-[0_0_5px_#39FF14] transition-all" data-icon="account_circle">account_circle</button>
</div>
<div class="bg-gradient-to-r from-transparent via-[#39FF14]/20 to-transparent h-[1px] w-full absolute bottom-0 right-0"></div>
</nav>
<!-- SideNavBar (OPERATOR Panel) -->
<aside class="fixed right-0 top-0 h-full pt-20 pb-6 flex flex-col z-40 bg-[#131313]/90 backdrop-blur-xl shadow-[10px_0_30px_rgba(0,0,0,0.5)] w-72 border-l border-[#39FF14]/10">
<div class="px-6 mb-8">
<div class="flex items-center justify-between">
<div>
<h2 class="text-[#39FF14] font-black font-headline text-lg">OPERATOR</h2>
<div class="flex items-center gap-2">
<span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
<span class="text-[10px] text-on-surface-variant tracking-widest uppercase">ONLINE</span>
</div>
</div>
<div class="w-12 h-12 rounded-lg border-2 border-primary/30 p-0.5 overflow-hidden">
<img alt="Player Avatar" class="w-full h-full object-cover" data-alt="Stylized neon cyber-punk profile avatar with glowing green accents and dark visor" src="https://lh3.googleusercontent.com/aida-public/AB6AXuD1_kUaXyafe_s9udcpE0fs0vUAHd3PGrqM8jTgBsd9_gXNgfn6xdjOlgCBFS1Elt6uhRMTivWIpA-S7R1a9gyuUJVmRVt3Y7y04vgVaqeRAeGvSS3ELJNqflksfKwqah2XIaDGNBGWloV7eo2T44UPv2fYWnZELSMy0gkEk01tK8zRxDOJ6ORwfYKdE1UqPx_uftFz-9RX6lBIGzYF4HX48DnxNHNFisz7sr8XHyJ_H7Sktz-wBj9xuQ30VZ5vjRKp067_h9S7ZiI"/>
</div>
</div>
</div>
<div class="flex-grow space-y-1">
<div class="px-3">
<p class="px-3 text-[10px] text-on-surface-variant font-bold mb-4 tracking-widest">قائمة اللاعبين (8/12)</p>
<!-- Player Item -->
<div class="text-[#39FF14] bg-[#39FF14]/5 border-r-4 border-[#39FF14] pr-4 py-3 flex items-center gap-3 transition-colors translate-x-1 duration-200">
<span class="material-symbols-outlined text-xl" data-icon="stars" style="font-variation-settings: 'FILL' 1;">stars</span>
<span class="font-bold text-sm">أحمد المضيف</span>
<span class="mr-auto text-[10px] bg-primary/20 px-2 py-0.5 rounded text-primary border border-primary/30">HOST</span>
</div>
<div class="text-gray-400 hover:text-gray-200 pr-4 py-3 flex items-center gap-3 transition-colors hover:bg-[#1f1f1f]">
<span class="material-symbols-outlined text-xl" data-icon="person">person</span>
<span class="font-bold text-sm">سارة جيمر</span>
</div>
<div class="text-gray-400 hover:text-gray-200 pr-4 py-3 flex items-center gap-3 transition-colors hover:bg-[#1f1f1f]">
<span class="material-symbols-outlined text-xl" data-icon="person">person</span>
<span class="font-bold text-sm">بندر 99</span>
</div>
<div class="text-gray-400 hover:text-gray-200 pr-4 py-3 flex items-center gap-3 transition-colors hover:bg-[#1f1f1f]">
<span class="material-symbols-outlined text-xl" data-icon="person">person</span>
<span class="font-bold text-sm">خالد الحربي</span>
</div>
<div class="text-gray-400 hover:text-gray-200 pr-4 py-3 flex items-center gap-3 transition-colors hover:bg-[#1f1f1f]">
<span class="material-symbols-outlined text-xl" data-icon="person">person</span>
<span class="font-bold text-sm">العنود</span>
</div>
</div>
</div>
<div class="mt-auto px-6 space-y-4">
<button class="w-full bg-gradient-to-br from-primary to-primary-container text-on-primary font-black py-4 rounded-lg shadow-[0_0_20px_rgba(47,248,1,0.3)] hover:shadow-[0_0_30px_rgba(47,248,1,0.5)] transition-all uppercase tracking-tighter text-sm">
                دعوة صديق
            </button>
<div class="flex justify-between pt-4 border-t border-outline-variant/30">
<button class="text-on-surface-variant hover:text-primary transition-colors flex items-center gap-2 text-xs">
<span class="material-symbols-outlined text-sm" data-icon="help">help</span> الدعم
                </button>
<button class="text-on-surface-variant hover:text-secondary transition-colors flex items-center gap-2 text-xs">
<span class="material-symbols-outlined text-sm" data-icon="logout">logout</span> خروج
                </button>
</div>
</div>
</aside>
<!-- Main Content Canvas -->
<main class="mr-72 pt-24 px-8 pb-8 h-screen flex flex-col gap-6">
<!-- Header Info Area -->
<header class="flex items-end justify-between">
<div class="space-y-2">
<h1 class="text-5xl font-black font-headline tracking-tighter text-white uppercase italic">
                    غرفة <span class="text-primary neon-text-primary">الديوانية</span>
</h1>
<div class="flex gap-4">
<span class="bg-surface-container-high px-4 py-1 rounded-full text-xs font-bold border border-outline-variant/30 flex items-center gap-2">
<span class="material-symbols-outlined text-xs" data-icon="public">public</span> عام
                    </span>
<span class="bg-surface-container-high px-4 py-1 rounded-full text-xs font-bold border border-outline-variant/30 flex items-center gap-2">
<span class="material-symbols-outlined text-xs text-secondary" data-icon="speed">speed</span> فائق السرعة
                    </span>
<span class="bg-surface-container-high px-4 py-1 rounded-full text-xs font-bold border border-outline-variant/30 flex items-center gap-2">
<span class="material-symbols-outlined text-xs text-tertiary" data-icon="tag">tag</span> #QAL_882
                    </span>
</div>
</div>
</header>
<!-- Central Action Grid -->
<div class="grid grid-cols-12 gap-6 flex-grow overflow-hidden">
<!-- Room Visualization (Bento Center) -->
<div class="col-span-8 flex flex-col gap-6 h-full">
<div class="bg-surface-container-low rounded-xl border border-outline-variant/10 relative overflow-hidden flex-grow flex items-center justify-center group">
<div class="absolute inset-0 opacity-20 pointer-events-none">
<img alt="Arena Background" class="w-full h-full object-cover" data-alt="A dark cinematic interior of a futuristic esports arena with emerald green laser lights and massive screens in the background" src="https://lh3.googleusercontent.com/aida-public/AB6AXuD7uclL3GQWvzKinbY-8tfaVX9D3T-kk7Im1mXSWMLx9SstTAhTPYOoo3ki8IrukGT7npwwc2i7T6QZNz2BvdMUpFQ6AmoXtkPInHNhnZzsjWlcszouHGQF8axi6ajMvejDmubhfvmjMaJORXoxguxk3nHImMUr3wiP8ai41BOd8oxBIPKetL82Y67cJmZWjNnnZCvXUrSAE1DQ6H4a_XXXHJOBcfX_6yA8aukPALao3pi8OP2XE2aUZuMYXQMTjDV7u67hEGGvnZ0"/>
</div>
<div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest via-transparent to-transparent"></div>
<div class="relative z-10 text-center flex flex-col items-center gap-8">
<div class="w-32 h-32 rounded-full border-4 border-primary/20 flex items-center justify-center relative animate-pulse">
<span class="material-symbols-outlined text-7xl text-primary neon-text-primary" data-icon="stadia_controller">stadia_controller</span>
<div class="absolute inset-0 rounded-full border border-primary animate-ping opacity-20"></div>
</div>
<div class="space-y-4">
<p class="text-on-surface-variant font-medium tracking-widest text-sm uppercase">في انتظار جميع اللاعبين...</p>
<button class="bg-gradient-to-r from-primary to-primary-container text-on-primary px-16 py-6 rounded-lg font-black text-2xl shadow-[0_0_40px_rgba(47,248,1,0.4)] hover:scale-105 transition-transform active:scale-95 flex items-center gap-4">
<span class="material-symbols-outlined text-3xl" data-icon="play_arrow" style="font-variation-settings: 'FILL' 1;">play_arrow</span>
                                بداية اللعبة
                            </button>
</div>
</div>
</div>
<!-- Chat Area (Bottom Left Layout) -->
<div class="h-64 bg-surface-container-lowest/50 backdrop-blur-xl rounded-xl border border-outline-variant/10 flex flex-col overflow-hidden">
<div class="px-4 py-2 border-b border-outline-variant/10 flex items-center justify-between">
<span class="text-[10px] font-black text-on-surface-variant uppercase tracking-widest">محادثة الغرفة</span>
<div class="flex gap-2">
<span class="w-1.5 h-1.5 rounded-full bg-tertiary"></span>
<span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
</div>
</div>
<div class="flex-grow p-4 space-y-4 overflow-y-auto font-body text-sm custom-scrollbar">
<div class="flex gap-3">
<span class="text-primary font-bold">بندر 99:</span>
<span class="text-on-surface-variant">شباب جاهزين؟ الفوز لي اليوم! 🔥</span>
</div>
<div class="flex gap-3">
<span class="text-tertiary font-bold">خالد الحربي:</span>
<span class="text-on-surface-variant">تحلم يا بندر، المركز الأول محجوز 😎</span>
</div>
<div class="flex gap-3">
<span class="text-on-surface-variant italic opacity-50">نظام: انضم "سطام" إلى الغرفة.</span>
</div>
<div class="flex gap-3">
<span class="text-secondary font-bold">العنود:</span>
<span class="text-on-surface-variant">من يبدأ؟ المضيف وينك؟</span>
</div>
</div>
<div class="p-3 bg-surface-container-high/50 border-t border-outline-variant/10">
<div class="relative">
<input class="w-full bg-surface-container-lowest border-none rounded-lg pr-4 pl-12 py-3 text-sm focus:ring-1 focus:ring-primary/50 text-on-surface placeholder:text-outline transition-all" placeholder="اكتب رسالتك هنا أو ابدأ التخمين..." type="text"/>
<button class="absolute left-2 top-1.5 p-1.5 text-primary hover:bg-primary/10 rounded-md transition-all">
<span class="material-symbols-outlined" data-icon="send">send</span>
</button>
</div>
</div>
</div>
</div>
<!-- Rules & Stats (Bento Right) -->
<div class="col-span-4 flex flex-col gap-6">
<!-- Game Settings Card -->
<div class="bg-surface-container-high rounded-xl p-6 border border-outline-variant/10 space-y-6">
<h3 class="text-xs font-black tracking-widest text-primary uppercase">إعدادات الجولة</h3>
<div class="space-y-4">
<div class="flex items-center justify-between group">
<div class="flex items-center gap-3">
<span class="material-symbols-outlined text-on-surface-variant group-hover:text-primary transition-colors" data-icon="timer">timer</span>
<span class="text-sm font-bold">وقت التخمين</span>
</div>
<span class="text-sm text-on-surface-variant">60 ثانية</span>
</div>
<div class="flex items-center justify-between group">
<div class="flex items-center gap-3">
<span class="material-symbols-outlined text-on-surface-variant group-hover:text-secondary transition-colors" data-icon="layers">layers</span>
<span class="text-sm font-bold">عدد الجولات</span>
</div>
<span class="text-sm text-on-surface-variant">5 جولات</span>
</div>
<div class="flex items-center justify-between group">
<div class="flex items-center gap-3">
<span class="material-symbols-outlined text-on-surface-variant group-hover:text-tertiary transition-colors" data-icon="category">category</span>
<span class="text-sm font-bold">الفئات</span>
</div>
<span class="text-sm text-on-surface-variant">أمثال، أفلام</span>
</div>
</div>
</div>
<!-- Live Feed / Activity -->
<div class="bg-surface-container-high rounded-xl border border-outline-variant/10 overflow-hidden flex-grow flex flex-col">
<div class="px-6 py-4 border-b border-outline-variant/10">
<h3 class="text-xs font-black tracking-widest text-secondary uppercase">آخر النشاطات</h3>
</div>
<div class="p-6 space-y-6">
<div class="flex items-start gap-4">
<div class="w-8 h-8 rounded-full bg-secondary/10 flex items-center justify-center text-secondary border border-secondary/20">
<span class="material-symbols-outlined text-lg" data-icon="bolt">bolt</span>
</div>
<div>
<p class="text-xs text-on-surface font-bold">سطام انضم للتو</p>
<p class="text-[10px] text-on-surface-variant">منذ ثانيتين</p>
</div>
</div>
<div class="flex items-start gap-4">
<div class="w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center text-primary border border-primary/20">
<span class="material-symbols-outlined text-lg" data-icon="trophy">trophy</span>
</div>
<div>
<p class="text-xs text-on-surface font-bold">خالد حقق لقب "ملك التخمين"</p>
<p class="text-[10px] text-on-surface-variant">منذ دقيقة</p>
</div>
</div>
</div>
</div>
</div>
</div>
</main>
<!-- Navigation Shell for Mobile (Hidden on Desktop) -->
<div class="md:hidden fixed bottom-0 left-0 w-full bg-[#131313] px-6 py-4 flex justify-between items-center z-50 border-t border-primary/10">
<button class="text-[#39FF14] flex flex-col items-center gap-1">
<span class="material-symbols-outlined" data-icon="grid_view" style="font-variation-settings: 'FILL' 1;">grid_view</span>
<span class="text-[10px] font-bold">Home</span>
</button>
<button class="text-gray-500 flex flex-col items-center gap-1">
<span class="material-symbols-outlined" data-icon="swords">swords</span>
<span class="text-[10px] font-bold">Lobbies</span>
</button>
<button class="text-gray-500 flex flex-col items-center gap-1">
<span class="material-symbols-outlined" data-icon="trophy">trophy</span>
<span class="text-[10px] font-bold">Stats</span>
</button>
<button class="text-gray-500 flex flex-col items-center gap-1">
<span class="material-symbols-outlined" data-icon="person">person</span>
<span class="text-[10px] font-bold">Profile</span>
</button>
</div>
</body></html>