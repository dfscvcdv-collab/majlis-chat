</div>
<div>
<div class="font-headline font-bold text-on-surface">Neon_Specter</div>
<div class="text-[10px] text-on-surface-variant uppercase">Veteran Rank</div>
</div>
</div>
<div class="col-span-3 text-center">
<div class="text-tertiary font-black font-headline">112 <span class="text-[10px] opacity-70">WPM</span></div>
</div>
<div class="col-span-3 text-right">
<div class="font-headline font-black text-xl">98,450</div>
</div>
</div>
<!-- Table Entry 5 (Me highlight) -->
<div class="grid grid-cols-12 gap-4 px-8 py-5 items-center bg-primary/5 border-y border-primary/10 relative group">
<div class="absolute left-0 top-0 w-1 h-full bg-primary"></div>
<div class="col-span-1 font-headline font-black text-xl text-primary">05</div>
<div class="col-span-5 flex items-center gap-4">
<div class="w-12 h-12 rounded-lg overflow-hidden border border-primary/50 shadow-[0_0_10px_rgba(57,255,20,0.2)]">
<img alt="Operator Status" class="w-full h-full object-cover" data-alt="close-up portrait of a futuristic gamer avatar with neon green cybernetic accents and dark matte helmet" src="https://lh3.googleusercontent.com/aida-public/AB6AXuARJV5Zd7JytqQBvfXF3lQfFItPRRaKOpXMjNSatUlQOn2ZOJaQIUer-kgVO1OLC6gs6FLKJLCvgjUabV2eSr-YTDj1gXWlAyo8QVZRMHmc5wVI7fMC1-e_8sBnewn1frKw8VYA84rnRgTdBC2xkGgrEJWwBWE6RhVXNtdUYlCfVMn8tu_8P32DTkII2UdeJfkUcpr7gi8fBhbQW1QyI-aB23vLd8PzwRHUG4zXlLY3QsMUk5yux77g2C1Jg5761HlFdLvFXwXqPC8"/>
