<!DOCTYPE html>

<html class="dark" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700;800;900&amp;family=Manrope:wght@300;400;500;600;700;800&amp;family=Tajawal:wght@400;500;700;800&amp;family=Cairo:wght@400;500;700;800&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            "colors": {
                    "surface-container-highest": "#262626",
                    "on-secondary-container": "#fff6f3",
                    "surface-tint": "#8eff71",
                    "tertiary-container": "#00e3fd",
                    "on-primary-fixed-variant": "#0d6200",
                    "on-primary-container": "#0b5800",
                    "error": "#ff7351",
                    "inverse-on-surface": "#555555",
                    "tertiary-fixed": "#00e3fd",
                    "secondary": "#ff7441",
                    "secondary-container": "#ab3600",
                    "on-tertiary-fixed": "#003840",
                    "on-primary-fixed": "#064200",
                    "surface-container-low": "#131313",
                    "secondary-dim": "#ff7441",
                    "surface-bright": "#2c2c2c",
                    "surface-container": "#191919",
                    "on-surface": "#ffffff",
                    "outline-variant": "#484848",
                    "on-secondary-fixed-variant": "#932d00",
                    "on-primary": "#0d6100",
                    "on-background": "#ffffff",
                    "on-secondary": "#410f00",
                    "primary-fixed": "#2ff801",
                    "on-tertiary-container": "#004d57",
                    "surface": "#0e0e0e",
                    "background": "#0e0e0e",
                    "primary-dim": "#2be800",
                    "on-error-container": "#ffd2c8",
                    "secondary-fixed-dim": "#ffb197",
                    "on-tertiary": "#005762",
                    "on-surface-variant": "#ababab",
                    "inverse-surface": "#f9f9f9",
                    "error-dim": "#d53d18",
                    "secondary-fixed": "#ffc4b1",
                    "on-error": "#450900",
                    "tertiary": "#81ecff",
                    "primary-container": "#2ff801",
                    "surface-container-lowest": "#000000",
                    "tertiary-dim": "#00d4ec",
                    "tertiary-fixed-dim": "#00d4ec",
                    "outline": "#757575",
                    "inverse-primary": "#106f00",
                    "error-container": "#b92902",
                    "primary": "#8eff71",
                    "on-secondary-fixed": "#631b00",
                    "surface-variant": "#262626",
                    "on-tertiary-fixed-variant": "#005762",
                    "surface-container-high": "#1f1f1f",
                    "surface-dim": "#0e0e0e",
                    "primary-fixed-dim": "#2be800"
            },
            "borderRadius": {
                    "DEFAULT": "0.125rem",
                    "lg": "0.25rem",
                    "xl": "0.5rem",
                    "full": "0.75rem"
            },
            "fontFamily": {
                    "headline": ["Space Grotesk"],
                    "body": ["Manrope"],
                    "label": ["Space Grotesk"]
            }
          },
        },
      }
    </script>
<style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .neon-glow-primary {
            box-shadow: 0 0 15px rgba(57, 255, 20, 0.4);
        }
        .neon-text-primary {
            text-shadow: 0 0 8px rgba(57, 255, 20, 0.6);
        }
        ::-webkit-scrollbar {
            width: 4px;
        }
        ::-webkit-scrollbar-track {
            background: #0e0e0e;
        }
        ::-webkit-scrollbar-thumb {
            background: #1f1f1f;
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #39FF14;
        }
    </style>
</head>
<body class="bg-surface text-on-surface font-body selection:bg-primary selection:text-on-primary">
<!-- TopNavBar -->
<header class="fixed top-0 w-full z-50 bg-[#131313] shadow-[0_4px_20px_rgba(0,0,0,0.5)] flex justify-between items-center px-6 h-16 w-full">
<div class="flex items-center gap-8">
<span class="text-2xl font-black italic text-[#39FF14] drop-shadow-[0_0_8px_rgba(57,255,20,0.6)] font-['Space_Grotesk'] tracking-tighter uppercase">AL-QALLABI</span>
<nav class="hidden md:flex gap-6 font-['Space_Grotesk'] tracking-tighter uppercase">
<a class="text-[#ababab] hover:text-[#39FF14] transition-colors duration-300 active:scale-95 duration-150" href="#">Home</a>
<a class="text-[#ababab] hover:text-[#39FF14] transition-colors duration-300 active:scale-95 duration-150" href="#">Lobbies</a>
<a class="text-[#39FF14] border-b-2 border-[#39FF14] pb-1 active:scale-95 duration-150" href="#">Leaderboard</a>
<a class="text-[#ababab] hover:text-[#39FF14] transition-colors duration-300 active:scale-95 duration-150" href="#">Store</a>
</nav>
</div>
<div class="flex items-center gap-4">
<button class="text-[#ababab] hover:text-[#39FF14] transition-colors duration-300 active:scale-95 duration-150">
<span class="material-symbols-outlined">notifications</span>
</button>
<button class="text-[#ababab] hover:text-[#39FF14] transition-colors duration-300 active:scale-95 duration-150">
<span class="material-symbols-outlined">settings</span>
</button>
<div class="w-8 h-8 rounded-full overflow-hidden border border-primary/20">
<img alt="User Profile Avatar" class="w-full h-full object-cover" data-alt="close-up portrait of a futuristic gamer avatar with neon green cybernetic accents and dark matte helmet" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBCTkcsYYewDkibiervhpEAetuBOS7M0I2JUjo-JPzx4KzUIaVnzrCZA_pz9Q7bLRZdMfkerMgzXjQeYFUjwDwjHuuPk3O4SRfegYU7jBJZuqpaApW0eL8j2MLRW9B-gKBXeVZZdHBIeFMNcDnCFKqRAyrt6FMApTaW2kBdtRY7ys6_f9DPhYQthzZ1mFUHswV0GXmBd9pTADyJ_yaKjIgPhxgnNyAlN8yqipM_xeuQyhwMToUNu5k9pqcR1_Aplz3lTTgfRMCyQf0"/>
</div>
</div>
</header>
<!-- SideNavBar -->
<aside class="hidden md:flex fixed left-0 top-16 h-[calc(100vh-64px)] w-64 z-40 bg-[#131313]/90 backdrop-blur-xl border-r border-[#39FF14]/10 flex flex-col py-8 gap-2 font-['Space_Grotesk'] font-bold shadow-[10px_0_30px_rgba(0,0,0,0.8)]">
<div class="px-6 mb-8">
<div class="flex items-center gap-3 p-3 rounded-xl bg-surface-container-high border border-outline-variant/10">
<div class="w-10 h-10 rounded-lg bg-primary/20 flex items-center justify-center text-primary">
<span class="material-symbols-outlined">person</span>
</div>
<div>
<div class="text-xs text-on-surface-variant font-medium">OPERATOR_01</div>
<div class="text-[10px] text-primary flex items-center gap-1">
<span class="w-1.5 h-1.5 rounded-full bg-primary shadow-[0_0_5px_#39FF14]"></span>
                        Online
                    </div>
</div>
</div>
</div>
<div class="flex-1 space-y-1">
<a class="flex items-center gap-4 text-[#ababab] px-4 py-3 hover:bg-[#1f1f1f] hover:translate-x-2 transition-transform duration-200 cursor-pointer active:brightness-125" href="#">
<span class="material-symbols-outlined">home</span> Home
            </a>
<a class="flex items-center gap-4 text-[#ababab] px-4 py-3 hover:bg-[#1f1f1f] hover:translate-x-2 transition-transform duration-200 cursor-pointer active:brightness-125" href="#">
<span class="material-symbols-outlined">sports_esports</span> Lobbies
            </a>
<a class="flex items-center gap-4 text-[#39FF14] bg-[#39FF14]/10 border-l-4 border-[#39FF14] px-4 py-3 ml-[-1px] hover:translate-x-2 transition-transform duration-200 cursor-pointer active:brightness-125" href="#">
<span class="material-symbols-outlined">leaderboard</span> Leaderboard
            </a>
<a class="flex items-center gap-4 text-[#ababab] px-4 py-3 hover:bg-[#1f1f1f] hover:translate-x-2 transition-transform duration-200 cursor-pointer active:brightness-125" href="#">
<span class="material-symbols-outlined">shopping_cart</span> Store
            </a>
<a class="flex items-center gap-4 text-[#ababab] px-4 py-3 hover:bg-[#1f1f1f] hover:translate-x-2 transition-transform duration-200 cursor-pointer active:brightness-125" href="#">
<span class="material-symbols-outlined">person</span> Profile
            </a>
</div>
<div class="px-4 mb-4">
<button class="w-full bg-gradient-to-r from-primary to-primary-container text-on-primary py-3 rounded-lg font-black uppercase tracking-widest text-sm shadow-[0_0_15px_rgba(57,255,20,0.3)] hover:brightness-110 active:scale-95 transition-all">
                Create Room
            </button>
</div>
<div class="border-t border-outline-variant/10 pt-4 mt-auto">
<a class="flex items-center gap-4 text-[#ababab] px-4 py-3 hover:bg-[#1f1f1f] hover:translate-x-2 transition-transform duration-200 cursor-pointer active:brightness-125" href="#">
<span class="material-symbols-outlined">help</span> Support
            </a>
<a class="flex items-center gap-4 text-error px-4 py-3 hover:bg-error/5 hover:translate-x-2 transition-transform duration-200 cursor-pointer active:brightness-125" href="#">
<span class="material-symbols-outlined">logout</span> Logout
            </a>
</div>
</aside>
<!-- Main Content Canvas -->
<main class="pt-24 pb-24 md:pb-12 md:pl-72 px-6 min-h-screen">
<!-- Header Section -->
<div class="max-w-6xl mx-auto mb-12">
<div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
<div>
<h1 class="font-headline text-5xl md:text-7xl font-extrabold tracking-tighter uppercase mb-4 text-surface-tint neon-text-primary">Global Ranks</h1>
<p class="text-on-surface-variant max-w-xl text-lg">The world's elite competitors battling for dominance across the Al-Qallabi universe. Your position defines your legacy.</p>
</div>
<div class="flex gap-2 bg-surface-container p-1 rounded-xl border border-outline-variant/20">
<button class="px-6 py-2 rounded-lg bg-surface-container-high text-primary font-bold font-headline transition-all">Weekly</button>
<button class="px-6 py-2 rounded-lg text-on-surface-variant hover:text-on-surface font-bold font-headline transition-all">All-Time</button>
</div>
</div>
</div>
<!-- Games Grid Categories -->
<div class="max-w-6xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-4 mb-12">
<div class="bg-surface-container-high border-2 border-primary p-4 rounded-xl cursor-pointer hover:bg-surface-container-highest transition-colors relative overflow-hidden group">
<div class="absolute -right-4 -bottom-4 opacity-10 group-hover:opacity-20 transition-opacity">
<span class="material-symbols-outlined text-8xl">draw</span>
</div>
<span class="material-symbols-outlined text-primary mb-2">draw</span>
<h3 class="font-headline font-bold uppercase tracking-tight">Drawing</h3>
<p class="text-[10px] text-on-surface-variant">Active Players: 12.4k</p>
</div>
<div class="bg-surface-container-low border border-outline-variant/20 p-4 rounded-xl cursor-pointer hover:bg-surface-container-highest transition-colors relative overflow-hidden group">
<div class="absolute -right-4 -bottom-4 opacity-10 group-hover:opacity-20 transition-opacity">
<span class="material-symbols-outlined text-8xl">keyboard</span>
</div>
<span class="material-symbols-outlined text-on-surface-variant mb-2">keyboard</span>
<h3 class="font-headline font-bold uppercase tracking-tight">Fast Keyboard</h3>
<p class="text-[10px] text-on-surface-variant">Active Players: 8.9k</p>
</div>
<div class="bg-surface-container-low border border-outline-variant/20 p-4 rounded-xl cursor-pointer hover:bg-surface-container-highest transition-colors relative overflow-hidden group">
<div class="absolute -right-4 -bottom-4 opacity-10 group-hover:opacity-20 transition-opacity">
<span class="material-symbols-outlined text-8xl">calculate</span>
</div>
<span class="material-symbols-outlined text-on-surface-variant mb-2">calculate</span>
<h3 class="font-headline font-bold uppercase tracking-tight">Math Blitz</h3>
<p class="text-[10px] text-on-surface-variant">Active Players: 5.2k</p>
</div>
<div class="bg-surface-container-low border border-outline-variant/20 p-4 rounded-xl cursor-pointer hover:bg-surface-container-highest transition-colors relative overflow-hidden group">
<div class="absolute -right-4 -bottom-4 opacity-10 group-hover:opacity-20 transition-opacity">
<span class="material-symbols-outlined text-8xl">memory</span>
</div>
<span class="material-symbols-outlined text-on-surface-variant mb-2">memory</span>
<h3 class="font-headline font-bold uppercase tracking-tight">Memory Tile</h3>
<p class="text-[10px] text-on-surface-variant">Active Players: 7.1k</p>
</div>
</div>
<!-- Top 3 Podium (Asymmetric) -->
<div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8 mb-16 items-end">
<!-- Rank 2 -->
<div class="order-2 md:order-1 bg-surface-container border border-outline-variant/30 p-8 rounded-2xl relative group hover:border-secondary/50 transition-all">
<div class="absolute -top-6 left-1/2 -translate-x-1/2 w-12 h-12 bg-surface border-4 border-secondary rounded-full flex items-center justify-center text-secondary font-black text-xl shadow-[0_0_15px_rgba(255,116,65,0.4)]">2</div>
<div class="flex flex-col items-center">
<div class="w-24 h-24 rounded-full border-4 border-secondary/30 p-1 mb-4 group-hover:border-secondary transition-all">
