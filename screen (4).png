<div class="w-full h-1 bg-outline-variant/20 rounded-full mb-4 overflow-hidden">
<div class="h-full bg-secondary w-[85%]"></div>
</div>
<div class="text-2xl font-black font-headline">152,430 <span class="text-xs text-on-surface-variant font-medium">PTS</span></div>
</div>
</div>
<!-- Rank 1 (Hero) -->
<div class="order-1 md:order-2 bg-surface-container-high border-2 border-primary p-10 rounded-2xl relative shadow-[0_20px_50px_rgba(57,255,20,0.1)] group hover:scale-[1.02] transition-all">
<div class="absolute -top-8 left-1/2 -translate-x-1/2 w-16 h-16 bg-surface border-4 border-primary rounded-full flex items-center justify-center text-primary font-black text-3xl shadow-[0_0_25px_rgba(57,255,20,0.6)]">1</div>
<div class="absolute inset-0 bg-gradient-to-b from-primary/5 to-transparent opacity-50 pointer-events-none"></div>
<div class="flex flex-col items-center relative z-10">
<div class="w-32 h-32 rounded-full border-4 border-primary p-1 mb-6 shadow-[0_0_30px_rgba(57,255,20,0.3)]">
<img alt="Rank 1 Avatar" class="w-full h-full rounded-full object-cover" data-alt="epic character portrait of a divine robotic entity with glowing emerald core and polished white plating" src="https://lh3.googleusercontent.com/aida-public/AB6AXuB-CgIlbDVPYn_cXHNXFgvGm3UMJwWMGdQ5biNsI8-DiWQ7lmIWKQhacZhK0MmI9LoZSIM3m1ESZaiy6HyHXKgFfghD3Al3lWa_kWl_7YLfavguW1JB43gPWftpd8-IoiPQ0FkO9e8gJ-4oIjdIb43InyCMZgH439N8Ccmpns2gMt8oeRAUyOB-YpNgWZa6clZJ5bVMpEMrsdqr8iT09lznHnacQQ7GmQk6A24bYhmBsVN4ligvS1XWjxtn9TtsIqkXjh78N8ANlB4"/>
</div>
<h4 class="font-headline font-black text-3xl uppercase tracking-tighter text-surface-tint neon-text-primary">X_ZENITH</h4>
<p class="text-primary font-bold mb-6 tracking-widest text-xs">GRAND OVERLORD</p>
<div class="flex gap-4 mb-6">
<div class="px-3 py-1 bg-primary/10 border border-primary/20 rounded-full text-[10px] text-primary font-bold uppercase">98% Win Rate</div>
<div class="px-3 py-1 bg-tertiary/10 border border-tertiary/20 rounded-full text-[10px] text-tertiary font-bold uppercase">Pro League</div>
</div>
<div class="text-4xl font-black font-headline text-on-surface">248,900 <span class="text-xs text-on-surface-variant font-medium">PTS</span></div>
</div>
</div>
<!-- Rank 3 -->
<div class="order-3 md:order-3 bg-surface-container border border-outline-variant/30 p-8 rounded-2xl relative group hover:border-tertiary/50 transition-all">
<div class="absolute -top-6 left-1/2 -translate-x-1/2 w-12 h-12 bg-surface border-4 border-tertiary rounded-full flex items-center justify-center text-tertiary font-black text-xl shadow-[0_0_15px_rgba(129,236,255,0.4)]">3</div>
<div class="flex flex-col items-center">
<div class="w-24 h-24 rounded-full border-4 border-tertiary/30 p-1 mb-4 group-hover:border-tertiary transition-all">
<img alt="Rank 3 Avatar" class="w-full h-full rounded-full object-cover" data-alt="cyberpunk character design with glowing neon blue hair and futuristic goggles in a rain-slicked city setting" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDII-_Y7b3hHCQwPDfjN6rMWGXd13Yk6P4O734ajNFGUPdnax4GFWvRu806HrQ71B6SqPXISkyoQBxMnXz0ZOQfaL4s1o9QKGVd1PVvEl4ynin7rtWKWsfy5Jy9hKlwWsCZwzn0eKlmiSL0WCp7dL6BxrOrpQBNiE_KJOvcDGEQFLKbBZxG32uV0bTk5eMsRuPIJ8ywRuWv37xlCMKKd1pvBNBkkWk2uo8ijLJjs5TdI1NCPDuCN5azW9LJ_sOqEfVMHOryjpgA_vw"/>
</div>
<h4 class="font-headline font-black text-xl uppercase tracking-tighter">Ghost_Pxl</h4>
<p class="text-tertiary font-bold mb-4">Elite Striker</p>
<div class="w-full h-1 bg-outline-variant/20 rounded-full mb-4 overflow-hidden">
<div class="h-full bg-tertiary w-[70%]"></div>
</div>
<div class="text-2xl font-black font-headline">124,100 <span class="text-xs text-on-surface-variant font-medium">PTS</span></div>
</div>
</div>
</div>
<!-- Main Leaderboard Table -->
<div class="max-w-6xl mx-auto">
<div class="bg-surface-container-low rounded-3xl overflow-hidden border border-outline-variant/10">
<div class="grid grid-cols-12 gap-4 px-8 py-6 border-b border-outline-variant/10 text-xs font-headline font-bold uppercase tracking-widest text-on-surface-variant">
<div class="col-span-1">Rank</div>
